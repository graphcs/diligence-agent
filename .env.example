# LLM provider is chosen in config/settings.yaml (`provider:`). Default: OpenRouter.
OPENROUTER_API_KEY=sk-or-...

# Only if you switch `provider: anthropic` (direct Claude API)
ANTHROPIC_API_KEY=

# Slack (only for the Slack demo; see slack/manifest.yaml)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
